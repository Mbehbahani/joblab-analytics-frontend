# PostgREST compatibility API exposed through the Cloudflare Tunnel
NEXT_PUBLIC_SUPABASE_URL=https://api.yourdomain.example
NEXT_PUBLIC_SUPABASE_ANON_KEY=PASTE_GENERATED_READONLY_JWT_HERE

# Server-side writer key for Next.js API routes — never expose to the client
SUPABASE_SERVICE_ROLE_KEY=PASTE_GENERATED_WRITER_JWT_HERE
SUPABASE_URL=https://api.yourdomain.example

# Optional: canonical site URL for SEO metadata
NEXT_PUBLIC_SITE_URL=
